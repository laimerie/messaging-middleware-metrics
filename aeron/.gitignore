# Raw benchmark data can get large; keep folder structure via .gitkeep but ignore run output.
results/**/*.csv
results/**/*.summary.txt
results/**/meta.json
results/**/20*/

# Benchmark run artifacts; keep only the directory placeholders.
results/**
!results/**/
!results/**/.gitkeep

# Built by scripts/package-native.sh: a tarball of binaries for the no-Docker servers.
# Reproducible from the image, and megabytes of ELF, so it does not belong in git.
dist/
